        "expected_state": "etag-1",
        "mutation": { "after_payload_hash": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" },
        "store": { "consumed": [], "now": "2026-08-28T12:00:00.000Z", "grant_expires_at": "2099-01-01T00:00:00.000Z", "target_state": "etag-1" }
      },
      "expected": { "outcome": "refused", "error": "PAYLOAD_HASH_MISMATCH" }
