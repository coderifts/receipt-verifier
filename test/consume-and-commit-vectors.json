    {
      "id": "CAC-LOST-RESPONSE",
      "title": "lost response / crash between mutate and attest — caller cannot tell committed from not",
      "input": {
        "grant": {
          "v": "cr.exec.v2",
          "grant_id": "g-1",
          "executor_id": "exec-a",
          "target_uri": "fs://repo/openapi.yaml",
          "after_payload_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "nonce_hash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        "state_nonce": "nonce-1",
        "expected_state": "etag-1",
        "mutation": { "after_payload_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
        "store": {
          "consumed": [],
          "now": "2026-08-28T12:00:00.000Z",
          "grant_expires_at": "2099-01-01T00:00:00.000Z",
          "target_state": "etag-1",
          "lost_response": true
        }
      },
      "expected": { "outcome": "indeterminate", "error": "EXECUTION_INDETERMINATE" }
    },
    {
      "id": "CAC-TARGET-STATE-CONFLICT",
      "title": "CAS expected_state does not match live target state",
      "input": {
        "grant": {
          "v": "cr.exec.v2",
          "grant_id": "g-1",
          "executor_id": "exec-a",
          "target_uri": "fs://repo/openapi.yaml",
          "after_payload_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "nonce_hash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        "state_nonce": "nonce-1",
        "expected_state": "etag-1",
        "mutation": { "after_payload_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
        "store": { "consumed": [], "now": "2026-08-28T12:00:00.000Z", "grant_expires_at": "2099-01-01T00:00:00.000Z", "target_state": "etag-other" }
      },
      "expected": { "outcome": "refused", "error": "TARGET_STATE_CONFLICT" }
    },
    {
      "id": "CAC-ATTESTATION-PENDING",
      "title": "mutation applied; executor attestation has not arrived",
      "input": {
        "grant": {
          "v": "cr.exec.v2",
          "grant_id": "g-1",
